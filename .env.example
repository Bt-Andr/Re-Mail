# Serveur
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# App utilisateur : messagerie, activation et retours OAuth Google.
WEBMAIL_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Base publique de CETTE API (sans slash final) — sert à construire l'URL de
# webhook unique par organisation affichée dans l'onboarding. En local, le
# fallback (http://localhost:$PORT) suffit ; en prod, à régler explicitement
# sur l'URL publique du backend déployé (ex. https://re-mail.onrender.com).
BACKEND_URL=http://localhost:3001

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/resend_mail_module"

# Auth
JWT_SECRET=change_me_generate_a_long_random_string

# Chiffrement des identifiants Resend par organisation (openssl rand -base64 32)
MASTER_ENCRYPTION_KEY=change_me_32_bytes_base64

# Chiffrement des fichiers d'invitation d'activation — clé distincte de la
# précédente, volontairement (openssl rand -base64 32)
INVITE_FILE_ENCRYPTION_KEY=change_me_32_bytes_base64

# Chiffrement des identifiants de boîtes externes connectées (IMAP/SMTP) — clé
# distincte des deux précédentes, volontairement (openssl rand -base64 32)
MAILBOX_CREDENTIAL_ENCRYPTION_KEY=change_me_32_bytes_base64

# Intervalle de polling des boîtes externes connectées, en ms (défaut 4 min)
MAILBOX_POLL_INTERVAL_MS=240000

# Stockage des pièces jointes (un seul compte partagé pour tout le SaaS,
# les fichiers sont rangés dans un dossier par organizationId)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth Gmail (boîtes externes) — un seul client OAuth "Web application" partagé pour
# tout le SaaS, créé dans Google Cloud Console (APIs & Services → Credentials).
# Redirect URI à enregistrer : <BACKEND_URL>/api/mailbox-connections/gmail/callback.
# Optionnel : sans ces valeurs, seul le connecteur IMAP/SMTP générique reste disponible.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Push mobile (Expo) — aucune clé requise pour l'API Expo Push publique
