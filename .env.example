# Serveur
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/resend_mail_module"

# Auth
JWT_SECRET=change_me_generate_a_long_random_string

# Chiffrement des identifiants Resend par organisation (openssl rand -base64 32)
MASTER_ENCRYPTION_KEY=change_me_32_bytes_base64

# Chiffrement des fichiers d'invitation d'activation — clé distincte de la
# précédente, volontairement (openssl rand -base64 32)
INVITE_FILE_ENCRYPTION_KEY=change_me_32_bytes_base64

# Stockage des pièces jointes (un seul compte partagé pour tout le SaaS,
# les fichiers sont rangés dans un dossier par organizationId)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push mobile (Expo) — aucune clé requise pour l'API Expo Push publique
