{
  "name": "resend-mail-module",
  "version": "0.1.0",
  "description": "Backend multi-tenant qui relie un compte Resend (par organisation) à une boîte mail partagée consultable via API/dashboard/app mobile.",
  "private": true,
  "main": "dist/server.js",
  "workspaces": [
    "packages/*",
    "web",
    "webmail",
    "mobile"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "platform-admin:create": "tsx src/scripts/createPlatformAdmin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.1",
    "imapflow": "^1.6.6",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.15",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.5",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
